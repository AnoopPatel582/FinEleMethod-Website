---
interface Props {
  id?: string;
}
const { id = 'theme-preference' } = Astro.props;
---

<div data-theme-control hidden class="flex items-center gap-3">
  <label for={id} class="text-sm text-muted">Appearance</label>
  <select
    id={id}
    name="theme"
    data-theme-select
    class="min-h-11 rounded-control border border-line px-3 py-2 text-sm"
  >
    <option value="system">System</option><option value="light">Light</option
    ><option value="dark">Dark</option>
  </select>
</div>
