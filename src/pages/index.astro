---
import SiteFrame from '../layouts/SiteFrame.astro';
import ButtonLink from '../components/ButtonLink.astro';
import Badge from '../components/Badge.astro';
import { solverDocument } from '../config/solver-evidence';
const capabilities = [
  {
    label: 'Q4 · 2D',
    title: 'Plane stress and plane strain',
    detail:
      'Four-node quadrilateral elements for two-dimensional linear-static analysis.',
  },
  {
    label: 'H8 · 3D',
    title: 'Solid mechanics in three dimensions',
    detail:
      'Eight-node hexahedral elements with isotropic linear-elastic materials.',
  },
  {
    label: 'VTU · Results',
    title: 'Results you can inspect',
    detail:
      'Displacement, reactions, stress and strain fields, including von Mises and principal stresses.',
  },
];
const workflow = [
  {
    title: 'Prepare and inspect',
    text: 'Read a supported ABAQUS .inp model. Check its elements, materials, loads and constraints before solving.',
  },
  {
    title: 'Run the analysis',
    text: 'Use the Windows workbench or standalone command-line engine. Keep project inputs and numbered analysis runs together.',
  },
  {
    title: 'Explore the results',
    text: 'Open the exported .vtu file in ParaView or another VTK-compatible visualizer. ParaView is installed separately.',
  },
];
---

<SiteFrame
  title="Finite-element analysis, from model to results"
  description="FinEleMethod is a custom C++20 finite-element solver and Windows workbench for Q4 and H8 linear-static analysis, with ABAQUS input and VTK output."
>
  <main id="main" tabindex="-1" class="page-container">
    <section
      aria-labelledby="home-title"
      class="border-b border-line py-14 sm:py-20"
    >
      <Badge>Custom C++20 solver · Windows x64</Badge>
      <div class="mt-7 grid gap-8 lg:grid-cols-[1.3fr_1fr] lg:items-end">
        <h1
          id="home-title"
          class="max-w-3xl text-4xl font-semibold leading-[1.05] sm:text-6xl"
        >
          From your model.<br /><span class="text-accent"
            >To the mechanics.</span
          >
        </h1>
        <p class="max-w-xl text-lg text-muted">
          <span translate="no">FinEleMethod</span> brings a custom finite-element
          engine and a native Windows workbench together. Solve linear-static solid
          mechanics problems, then explore the results in ParaView.
        </p>
      </div>
      <div class="mt-8 flex flex-wrap gap-3">
        <ButtonLink href="#workflow">Explore the workflow</ButtonLink>
        <ButtonLink
          href={solverDocument('docs/BEGINNERS_GUIDE.md')}
          variant="secondary">Read the beginner’s guide</ButtonLink
        >
      </div>
      <p class="mt-5 text-sm text-muted">
        Windows 10 or later · x64 · GUI and command-line workflows
      </p>
      <figure class="mt-10 rounded-panel border border-line bg-surface">
        <a
          href="/images/plate-hole-displacement.png"
          aria-label="Open full-size plate-with-a-hole displacement image"
          class="block rounded-t-panel"
        >
          <img
            src="/images/plate-hole-displacement.png"
            width="1380"
            height="630"
            fetchpriority="high"
            class="h-auto w-full rounded-t-panel"
            alt="ParaView displacement-magnitude contour of the supplied quarter plate-with-a-hole example, changing from blue on the left to amber on the right."
          />
        </a>
        <figcaption
          class="flex flex-wrap justify-between gap-3 px-5 py-4 text-sm text-muted"
        >
          <span>Plate with a hole · Displacement magnitude in ParaView</span>
          <span>Supplied example image · Open image for full-size legend</span>
        </figcaption>
      </figure>
    </section>
    <section
      aria-labelledby="capabilities-title"
      class="border-b border-line py-12 sm:py-16"
    >
      <p class="eyebrow text-accent">The solver</p>
      <h2
        id="capabilities-title"
        class="mt-4 text-3xl font-semibold sm:text-4xl"
      >
        A focused foundation for solid mechanics.
      </h2>
      <div class="mt-9 grid gap-8 lg:grid-cols-3">
        {
          capabilities.map((item) => (
            <article class="border-t border-line pt-6">
              <p class="font-mono text-sm text-accent">{item.label}</p>
              <h3 class="mt-4 text-xl font-semibold">{item.title}</h3>
              <p class="mt-4 text-muted">{item.detail}</p>
            </article>
          ))
        }
      </div>
      <p class="mt-8 max-w-3xl text-muted">
        Use multiple materials in one model, prescribed displacements,
        concentrated nodal loads and element pressure loads. Supply a consistent
        unit system; automatic unit conversion is not implemented.
      </p>
      <a
        href={solverDocument('README.md')}
        class="text-link mt-5 inline-flex min-h-11 items-center"
        >Read supported capabilities and limitations</a
      >
    </section>
    <section
      id="workflow"
      aria-labelledby="workflow-title"
      class="border-b border-line py-12 sm:py-16"
    >
      <p class="eyebrow text-accent">Your workflow</p>
      <h2 id="workflow-title" class="mt-4 text-3xl font-semibold sm:text-4xl">
        Inspect. Solve. Understand.
      </h2>
      <ol class="mt-9 grid gap-8 lg:grid-cols-3">
        {
          workflow.map((step, index) => (
            <li>
              <span class="font-mono text-3xl text-accent" aria-hidden="true">
                0{index + 1}
              </span>
              <h3 class="mt-4 text-xl font-semibold">{step.title}</h3>
              <p class="mt-4 text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </section>
    <section
      aria-labelledby="validation-title"
      class="grid gap-8 py-12 sm:py-16 lg:grid-cols-2"
    >
      <div>
        <p class="eyebrow text-accent">Evidence before confidence</p>
        <h2
          id="validation-title"
          class="mt-4 text-3xl font-semibold sm:text-4xl"
        >
          Understand the checks behind the result.
        </h2>
        <p class="mt-5 text-muted">
          The project documents comparisons for a cantilever beam, a plate with
          a hole and a compressed 3D block. Review each benchmark’s assumptions,
          mesh and acceptance criteria.
        </p>
        <a
          href={solverDocument('docs/RELEASE_VALIDATION.md')}
          class="text-link mt-5 inline-flex min-h-11 items-center"
          >Read the validation record</a
        >
      </div>
      <aside
        class="rounded-panel border border-line bg-elevated p-6 sm:p-8"
        aria-labelledby="limits-title"
      >
        <h3 id="limits-title" class="text-xl font-semibold">
          Before engineering use
        </h3>
        <p class="mt-4 text-muted">
          Independently validate results before engineering use. The supported
          scope is linear-static analysis with isotropic linear-elastic
          materials and a supported subset of ABAQUS input.
        </p>
        <p class="mt-4 text-muted">
          Benchmark checks do not establish correctness for every model. Review
          loads, boundary conditions, units and mesh suitability for your case.
        </p>
      </aside>
    </section>
  </main>
</SiteFrame>
